# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# URL опубликованного Cloudflare Worker для продакшн-сборки (например, на GitHub Pages).
# Оставьте пустым при локальной разработке (запросы пойдут на локальный /api).
# Пример для продакшна: VITE_API_BASE_URL="https://lea-booking-worker.<YOUR_SUBDOMAIN>.workers.dev"
VITE_API_BASE_URL=""

# Только для локальной разработки сервера (в Cloudflare эти значения хранятся в Worker Secrets):
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
ALLOWED_ORIGIN="https://<YOUR_GITHUB_USERNAME>.github.io"
SALON_TIMEZONE="Europe/Moscow"

